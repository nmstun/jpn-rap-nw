# https://genius.com/api-clients で作成したAPI Clientの
# "Client Access Token" をそのまま貼り付けてください(client_id/secretは不要)
GENIUS_ACCESS_TOKEN=your_access_token_here
LOG_LEVEL=info
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true にすると `*.vercel.app` のオリジンを一括許可(プレビューデプロイ用、本番では false 推奨)
CORS_ALLOW_VERCEL_PREVIEWS=false
VITE_API_BASE_URL=http://localhost:3001
